# Copy this file to .env in your repository root and fill in your credentials.
# Never commit .env or actual API keys to GitHub.

# Required for examples that call OpenAI's APIs (model, embeddings, web search)
OPENAI_API_KEY=

# Model defaults used by the Lesson 08 RAG scripts; change if necessary
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional: Qdrant Cloud (Lessons 08–10 only)
# Use the cluster endpoint, e.g. https://your-cluster.cloud.qdrant.io:6333
# Use a DATABASE API key belonging to that cluster, not a Cloud Management API key.
QDRANT_URL=
QDRANT_API_KEY=

# Optional: an already-indexed collection, when a lesson expects its name
QDRANT_COLLECTION=
